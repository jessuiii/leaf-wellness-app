# Python API Configuration
VITE_PYTHON_API_URL=http://localhost:8000

# Azure Cosmos DB Configuration (empty for development)
VITE_AZURE_COSMOS_ENDPOINT=
VITE_AZURE_COSMOS_KEY=
VITE_AZURE_COSMOS_DATABASE_ID=LeafGuardDB

# Azure Storage Account (empty for development)
VITE_AZURE_STORAGE_ACCOUNT_NAME=
VITE_AZURE_STORAGE_CONTAINER_NAME=glb-models
VITE_AZURE_STORAGE_SAS_TOKEN=

# Development Mode - set to false when Azure is configured
VITE_DEVELOPMENT_MODE=true
VITE_USE_AZURE_DATABASE=false