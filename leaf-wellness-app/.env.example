# Python Backend API Configuration
# Update this with your actual Python backend URL
VITE_PYTHON_API_URL=http://localhost:5000

# Azure Cosmos DB Configuration
# Replace these placeholder values with your actual Azure Cosmos DB credentials

# Cosmos DB Connection
VITE_AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
VITE_AZURE_COSMOS_KEY=your-cosmos-primary-key-here
VITE_AZURE_COSMOS_DATABASE_ID=leaf-wellness-db

# Container Names
VITE_AZURE_PLANTS_CONTAINER=plants
VITE_AZURE_SCAN_HISTORY_CONTAINER=scan-history
VITE_AZURE_TREATMENTS_CONTAINER=treatments

# Azure Storage (for GLB models - optional)
VITE_AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
VITE_AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
VITE_AZURE_STORAGE_CONTAINER_NAME=glb-models

# Development Mode (set to 'true' to use localhost fallback)
VITE_DEVELOPMENT_MODE=true
VITE_USE_LOCAL_FALLBACK=true
