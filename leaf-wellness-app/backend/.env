# Blob storage configuration (used for GLB models)
# Container: glb-models (public blob URLs provided below)
AZURE_STORAGE_ACCOUNT_NAME=leafguardstorage
AZURE_STORAGE_CONTAINER_NAME=glb-models
# If you need a connection string for private access, set it here. Leaving empty uses public blob URLs.
AZURE_STORAGE_CONNECTION_STRING=

# Direct GLB URLs (public blob links)
# These are the GLB models used by the frontend. Keep these as direct links when using public blobs.
DECEASED_LEAF_URL=https://leafguardstorage.blob.core.windows.net/glb-models/deceased-leaf.glb
HEALTHY_LEAF_URL=https://leafguardstorage.blob.core.windows.net/glb-models/healthy-leaf.glb

# Azure Digital Twins (optional) — preserved as requested
AZURE_DIGITAL_TWINS_URL=

# Note: This project is not using Azure Table Storage or Cosmos DB — local storage is used for DB during development.
AZURE_DIGITAL_TWINS_URL=

# API Configuration
API_HOST=localhost
API_PORT=8000