# Azure Configuration
# Copy this file to .env and fill in your Azure credentials

# Blob storage configuration (for GLB models)
# Set these if you need to access private blobs; public direct URLs are also supported.
AZURE_STORAGE_ACCOUNT_NAME=leafguardstorage
AZURE_STORAGE_CONTAINER_NAME=glb-models
AZURE_STORAGE_CONNECTION_STRING=

# Direct GLB URLs (public blob links) - replace with your own if different
DECEASED_LEAF_URL=https://leafguardstorage.blob.core.windows.net/glb-models/deceased-leaf.glb
HEALTHY_LEAF_URL=https://leafguardstorage.blob.core.windows.net/glb-models/healthy-leaf.glb

# Azure Digital Twins (optional)
AZURE_DIGITAL_TWINS_URL=

# Azure Authentication
# For local development, you can use Azure CLI: az login
# For production, use environment variables or managed identity
# AZURE_CLIENT_ID=your_client_id
# AZURE_CLIENT_SECRET=your_client_secret
# AZURE_TENANT_ID=your_tenant_id

# API Configuration
API_HOST=localhost
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development